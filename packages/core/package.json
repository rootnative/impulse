{
  "name": "@rootnative/impulse",
  "version": "0.0.0-alpha.0",
  "description": "Declarative gesture primitives for React Native, built on react-native-gesture-handler.",
  "license": "MIT",
  "author": "RootNative",
  "homepage": "https://github.com/rootnative/impulse",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rootnative/impulse.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/rootnative/impulse/issues"
  },
  "keywords": [
    "react-native",
    "gesture-handler",
    "gesture",
    "swipe",
    "drag",
    "pinch",
    "tap",
    "expo",
    "declarative"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "react-native": "./dist/index.js",
  "source": "./src/index.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/index.d.ts",
      "react-native": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./compose": {
      "types": "./dist/compose/index.d.ts",
      "react-native": "./dist/compose/index.js",
      "default": "./dist/compose/index.js"
    },
    "./raw": {
      "types": "./dist/raw/index.d.ts",
      "react-native": "./dist/raw/index.js",
      "default": "./dist/raw/index.js"
    },
    "./tap": {
      "types": "./dist/tap/index.d.ts",
      "react-native": "./dist/tap/index.js",
      "default": "./dist/tap/index.js"
    },
    "./drag": {
      "types": "./dist/drag/index.d.ts",
      "react-native": "./dist/drag/index.js",
      "default": "./dist/drag/index.js"
    },
    "./gesture-handler": {
      "types": "./dist/gesture-handler/index.d.ts",
      "react-native": "./dist/gesture-handler/index.js",
      "default": "./dist/gesture-handler/index.js"
    },
    "./jest-preset": "./jest-preset.cjs",
    "./jest-setup": "./jest-setup.cjs"
  },
  "files": [
    "dist",
    "src",
    "jest-preset.cjs",
    "jest-setup.cjs",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "!**/__tests__",
    "!**/*.test.*"
  ],
  "scripts": {
    "build": "tsup",
    "prepack": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "test": "jest",
    "lint": "eslint . --max-warnings 0",
    "clean": "rm -rf dist .turbo *.tsbuildinfo"
  },
  "peerDependencies": {
    "react": ">=19.2.3 <20.0.0",
    "react-native": ">=0.83.0 <0.87.0",
    "react-native-gesture-handler": ">=2.28.0 <3.0.0",
    "react-native-reanimated": ">=4.5.0 <4.6.0",
    "react-native-worklets": ">=0.10.0 <0.11.0"
  },
  "devDependencies": {
    "@react-native/babel-preset": "^0.86.3",
    "@react-native/jest-preset": "^0.86.3",
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "^29.5.14",
    "@types/react": "^19.2.0",
    "jest": "^29.7.0",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-worklets": "0.10.1",
    "react-test-renderer": "19.2.3",
    "tsup": "^8.3.5",
    "typescript": "^5.7.3"
  },
  "publishConfig": {
    "access": "public"
  }
}
